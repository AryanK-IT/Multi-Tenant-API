datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  owner
  admin
  member
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum ActorType {
  user
  api_key
  system
}

enum ApiKeyScope {
  read
  read_write
}

model Org {
  id            String          @id @default(uuid())
  name          String
  createdAt     DateTime        @default(now())
  memberships   OrgMembership[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]
  projects      Project[]
  tasks         Task[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  webhookDeliveries WebhookDelivery[]

  @@map("orgs")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  memberships         OrgMembership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]
  projectsCreated     Project[]            @relation("ProjectsCreated")
  tasksCreated        Task[]               @relation("TasksCreated")
  tasksAssigned       Task[]               @relation("TasksAssigned")
  apiKeysCreated      ApiKey[]             @relation("ApiKeysCreated")
  webhooksCreated     Webhook[]            @relation("WebhooksCreated")

  @@map("users")
}

model OrgMembership {
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("org_memberships")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  orgId        String
  familyId     String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([familyId])
  @@index([userId])
  @@index([orgId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Invitation {
  id          String    @id @default(uuid())
  orgId       String
  email       String
  role        Role
  tokenHash   String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@index([tokenHash])
  @@index([orgId])
  @@map("invitations")
}

model Project {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ProjectsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@index([orgId, createdAt, id])
  @@map("projects")
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  orgId       String
  title       String
  description String?
  status      TaskStatus @default(todo)
  assigneeId  String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project  @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User     @relation("TasksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?    @relation("TasksAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, projectId, status, id])
  @@index([orgId, assigneeId])
  @@index([orgId, createdAt, id])
  @@map("tasks")
}

model AuditLog {
  id         String    @id @default(uuid())
  orgId      String
  actorType  ActorType
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt, id])
  @@index([orgId, action, createdAt])
  @@index([orgId, actorId])
  @@map("audit_logs")
}

model ApiKey {
  id           String       @id @default(uuid())
  orgId        String
  name         String
  prefix       String       @unique
  hashedSecret String
  scope        ApiKeyScope  @default(read)
  createdById  String
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())

  org          Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeysCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([prefix])
  @@index([orgId, createdAt, id])
  @@index([orgId])
  @@map("api_keys")
}

model Webhook {
  id                  String            @id @default(uuid())
  orgId               String
  url                 String
  encryptedSecret     String
  events              String[]
  active              Boolean           @default(true)
  consecutiveFailures Int               @default(0)
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  org                 Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy           User              @relation("WebhooksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  deliveries          WebhookDelivery[]

  @@index([orgId, createdAt, id])
  @@index([orgId])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  orgId      String
  eventId    String
  eventType  String
  attempt    Int
  statusCode Int?
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt, id])
  @@index([orgId, createdAt, id])
  @@index([eventId])
  @@map("webhook_deliveries")
}

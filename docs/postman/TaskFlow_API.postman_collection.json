    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Sign Up (Create Tenant & Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.tokens) {",
                  "        pm.environment.set('accessToken', json.tokens.accessToken);",
                  "        pm.environment.set('refreshToken', json.tokens.refreshToken);",
                  "    }",
                  "    if (json.org) {",
                  "        pm.environment.set('orgId', json.org.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orgName\": \"Acme Corp\",\n  \"email\": \"owner@acme.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          }
        },
